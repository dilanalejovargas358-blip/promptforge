// Prisma schema para PromptForge Pro
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Nota: SQLite no soporta enums de Prisma, por eso se usan String.
// Valores: role => "USER" | "ADMIN"
//          status => "DRAFT" | "PUBLISHED" | "ARCHIVED"
//          reportStatus => "PENDING" | "REVIEWED" | "DISMISSED"
//          transaction.type => "EARN" | "SPEND" | "DONATE" | "PREMIUM"
//          adView.adType => "GOOGLE" | "SPONSOR"

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER")
  credits       Int       @default(10) // Saldo de créditos (default 10)
  bio           String?
  isPremium     Boolean   @default(false)
  premiumUntil  DateTime? // Válido mientras premiumUntil > now
  // Fecha del último crédito diario Premium otorgado (para "+5 créditos/día").
  // Campo interno de soporte, no forma parte de la UI.
  premiumDailyAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  prompts      Prompt[]
  savedPrompts SavedPrompt[]
  reports      Report[]
  reportsMade  Report[]      @relation("ReportAuthor")
  transactions Transaction[]
  adViews      AdView[]

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Prompt {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  content     String // El prompt en sí
  category    String
  model       String // ChatGPT, Midjourney, DALL-E, etc.
  price       Float    @default(0)
  isPaid      Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  isSponsored Boolean  @default(false) // Prompt patrocinado / anuncio de creador
  status      String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  views       Int      @default(0)
  savesCount  Int      @default(0)
  totalCredits Int     @default(0) // Créditos totales recibidos como apoyo
  tags        String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String
  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  saves    SavedPrompt[]
  reports  Report[]
}

// Registro contable de movimientos de créditos del usuario.
model Transaction {
  id          String   @id @default(cuid())
  type        String // EARN | SPEND | DONATE | PREMIUM
  amount      Int // Positivo = entrada; (ver description para contexto de DONATE/SPEND)
  description String
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Cada visualización completada de un anuncio que otorga crédito.
model AdView {
  id           String   @id @default(cuid())
  adType       String   @default("GOOGLE") // GOOGLE | SPONSOR
  creditsEarned Int     @default(1)
  viewedAt     DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
}

model SavedPrompt {
  id        String   @id @default(cuid())
  userId    String
  promptId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([userId, promptId])
}

model Report {
  id        String   @id @default(cuid())
  reason    String
  status    String   @default("PENDING") // PENDING | REVIEWED | DISMISSED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  promptId   String
  prompt     Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User   @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  authorId   String
  author     User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
